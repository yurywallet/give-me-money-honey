# Copy to .env and fill in to enable the real LinkedIn source.
# Without these, the server runs fine on MockJobSource alone (no setup needed).
APIFY_TOKEN=
# Only needed for GMMH_LINKEDIN_ACTOR=legacy (below); the default remote
# source supplies its own actor id.
APIFY_ACTOR_ID=

# Which LinkedIn source to use (sources/linkedin_selector.py):
#   remote (default) - passes LinkedIn's OWN f_WT=2 remote filter in a search
#       URL, which is VERIFIED to actually filter (A/B 2026-08-02: only 4/15
#       overlap vs unfiltered). ~$0.001/job, ~2.4x the legacy cost.
#   legacy           - cheaper, but its actor SILENTLY IGNORES the remote and
#       full-time parameters, so results come back unfiltered with no
#       work-arrangement signal at all.
# Switch to legacy if the Apify credit runs low. Both dedup against the same
# LinkedIn job IDs, so switching doesn't re-insert existing jobs as new.
# GMMH_LINKEDIN_ACTOR=remote
# GMMH_LINKEDIN_REMOTE_ACTOR_ID=curious_coder~linkedin-jobs-scraper  # default shown

# Greenhouse source (sources/greenhouse_source.py) - public, free, no-auth API,
# ADDITIVE alongside LinkedIn (both can run together; Mock is only used when
# NEITHER real source is configured). Comma-separated Greenhouse BOARD TOKENS,
# not always the obvious brand name - e.g. Aurora Innovation is
# "aurorainnovation", not "aurora". Find a company's token from its careers
# page URL (boards.greenhouse.io/<token>) or by trying the obvious guess
# against https://boards-api.greenhouse.io/v1/boards/<token>/jobs (200 = real).
# No cross-company keyword search exists on this API - only companies listed
# here get checked, each filtered client-side by title keyword.
GREENHOUSE_COMPANIES=

# LLM provider for fit summaries + the agent's reflect step. Both
# fit_summary.default_generate_fn and agent.default_reflect_fn pick, in order:
# OLLAMA_MODEL > GEMINI_API_KEY > ANTHROPIC_API_KEY. Set at least one; without
# any, everything else still works (tests inject fakes). A shell-level key is
# NOT inherited here - server.py calls load_dotenv() at import, so set it here.

# Option A - Ollama (LOCAL, unlimited, free, private, no rate limits). Set the
# model to activate it (highest priority). Requires Ollama running with the
# model pulled: `ollama pull mistral-nemo`. Tradeoff: ~30-120s per summary vs.
# a cloud API's near-instant response.
# OLLAMA_MODEL=mistral-nemo
# OLLAMA_HOST=http://localhost:11434   # optional override, default shown

# Option B - Anthropic Claude (needs a Console API key, separate from a
# Claude subscription).
ANTHROPIC_API_KEY=

# Option C - Google Gemini (free tier: 5 req/min, 20 req/day - fine for a few
# jobs, tight for bulk; enable billing for headroom). Get a key at
# aistudio.google.com/apikey.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   # optional override, default shown

# Optional overrides (defaults shown)
GMMH_POLL_INTERVAL_MINUTES=60
GMMH_DB_PATH=jobs.db
